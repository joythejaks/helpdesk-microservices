APP_PORT=8082

DB_HOST=ticket-db
DB_PORT=5432
DB_USER=ticket
DB_PASSWORD=ticket
DB_NAME=ticket_db

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Must match INTERNAL_SHARED_SECRET on api-gateway. Requests without this
# header are rejected — closes off direct access that bypasses the gateway's
# JWT validation. Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-value

# Rate limit for POST /tickets and the attachment upload route (token
# bucket, per client IP). Optional, defaults to 5 rps / burst 10 if unset.
TICKET_RATE_LIMIT_RPS=5
TICKET_RATE_LIMIT_BURST=10

# Shared rate-limit state (Redis). Optional: when unset, each process falls back to
# its own in-memory limiter, which means N replicas = N x the configured limit.
# Limiters fail open if Redis is unreachable.
REDIS_URL=redis://redis:6379/0
