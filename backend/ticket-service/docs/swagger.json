                    },
                    {
                        "description": "Target agent (admin only)",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/http.AssignTicketRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ticket assigned",
