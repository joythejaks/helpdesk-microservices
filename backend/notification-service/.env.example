APP_PORT=8083
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
JWT_SECRET=your-secret-key-change-this

DB_HOST=notification-db
DB_PORT=5432
DB_USER=notification
DB_PASSWORD=notification
DB_NAME=notification_db

# Comma-separated list of allowed WebSocket origins, e.g. https://app.example.com
# Defaults to "*" (dev only) if unset. Non-browser clients (mobile apps) that
# don't send an Origin header are always allowed through.
ALLOWED_ORIGINS=*

# Per-client-IP token bucket rate limit for WebSocket upgrade attempts.
WS_RATE_LIMIT_RPS=5
WS_RATE_LIMIT_BURST=10

# Hard cap on concurrent WebSocket connections.
MAX_WS_CONNECTIONS=1000

# Shared rate-limit state (Redis). Optional: when unset, each process falls back to
# its own in-memory limiter, which means N replicas = N x the configured limit.
# Limiters fail open if Redis is unreachable.
REDIS_URL=redis://redis:6379/0

# Optional. Comma-separated CIDRs (or IPs) of reverse proxies whose
# X-Forwarded-For is trusted for the /ws rate limit — e.g. the Caddy network.
# Empty (default) never trusts X-Forwarded-For and limits on the TCP peer.
#TRUSTED_PROXIES=10.244.0.0/16

# Optional. classic (default) or quorum. Must be the SAME value in ticket-service and
# notification-service, because both declare the ticket_created queue and RabbitMQ rejects a
# redeclare with different arguments. quorum is for a clustered RabbitMQ (Kubernetes); switching
# an existing broker means deleting the old classic ticket_created queue first.
#RABBITMQ_QUEUE_TYPE=quorum

# Optional. Database connection pool, PER REPLICA. Defaults are 20 open / 5 idle / 30m lifetime:
# each service has its own Postgres (max_connections defaults to 100) and the HPA can run up to 4
# replicas, so replicas x DB_MAX_OPEN_CONNS must stay well under max_connections. With no limit,
# busy replicas exhaust the database ("too many clients already"); with a limit, a request that
# finds the pool exhausted waits for a free connection instead.
#DB_MAX_OPEN_CONNS=20
#DB_MAX_IDLE_CONNS=5
#DB_CONN_MAX_LIFETIME=30m
