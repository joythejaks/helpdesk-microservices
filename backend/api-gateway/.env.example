APP_PORT=8080

JWT_SECRET=change-me-to-a-long-random-value

AUTH_SERVICE_URL=http://auth-service:8081
TICKET_SERVICE_URL=http://ticket-service:8082

# Comma-separated list of allowed CORS origins, e.g. https://app.example.com,https://admin.example.com
# Unset means "*" (dev only, logs a warning). https://localhost is Caddy in compose;
# the mobile app is not subject to CORS. To use Swagger "Try it out" from the
# service ports, add e.g. http://localhost:8081,http://localhost:8082 while developing.
ALLOWED_ORIGINS=https://localhost

# Per-client-IP token bucket rate limit.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Must match INTERNAL_SHARED_SECRET on auth-service / ticket-service. Proves
# to those services that a request actually came through this gateway.
# Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-value

# Shared rate-limit state (Redis). Optional: when unset, each process falls back to
# its own in-memory limiter, which means N replicas = N x the configured limit.
# Limiters fail open if Redis is unreachable.
REDIS_URL=redis://redis:6379/0
