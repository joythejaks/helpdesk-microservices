{
	# Local dev: Caddy generates and locally-trusts its own CA so
	# https://localhost gets a real (if not publicly trusted) padlock with
	# zero manual cert handling. Once this is deployed behind a real
	# domain, delete this global block and set SITE_ADDRESS to the domain
	# — Caddy will then fetch a real Let's Encrypt certificate
	# automatically (port 80 must be reachable for the ACME challenge).
	local_certs
}

# SITE_ADDRESS defaults to localhost; set it to the real domain for a
# deployment (docker compose: environment, Kubernetes: the caddy Deployment).
{$SITE_ADDRESS:localhost} {
	# notification-service is not behind the gateway (its reverse proxy
	# doesn't handle WebSocket upgrades, and its REST API authenticates
	# itself with the JWT), so it gets its own route here — which also
	# puts /ws behind TLS. Caddy's reverse_proxy handles the upgrade.
	@notifications path /ws /notifications /notifications/*
	handle @notifications {
		reverse_proxy notification-service:8083
	}

	handle {
		reverse_proxy api-gateway:8080
	}
}
